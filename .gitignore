# agentflow:start  (AgentFlow block: an AgentFlow install or update replaces only the lines between the markers)
# launcher process state and logs; verify records (acceptance evidence) are committed
docs/tasks/.runtime/*
!docs/tasks/.runtime/*.verify.json
# dashboard: built pages and local versions of its sources
.agentflow/dashboard/out/
.agentflow/dashboard/versions/
__pycache__/
# agentflow:end

# template repository only, never copied into projects: requests from other projects' agents (local inbox)
requests/
